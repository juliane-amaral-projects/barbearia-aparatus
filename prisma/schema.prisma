// Arquivo que define as tabelas

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  // Banco de dados que está em uso
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabela principal
model Barbershop {
  id          String              @id @default(uuid())
  name        String
  address     String
  description String
  // Deve-se salvar a URL da imagem no banco de dados
  imageUrl    String
  phones      String[]
  services    BarbershopService[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  priceInCents Int
  bookings     Booking[]
}

// Tabela de Agendamento
model Booking {
  id                  String             @id @default(uuid())
  serviceId           String
  //service        BarbershopService @relation(fields: [serviceId], references: [id])
  barbershopId        String
  //barbershop Barbershop        @relation(fields: [barbershopId], references: [id])
  //userId String
  //user User @relation(fields: [userId], references: [id])
  // Status - Confirmado = se a data for no futuro; Finalizado = se a data for no passado; Cancelado = cancelado. 
  date                DateTime           @db.Timestamptz // Timestamptz - salva o horário em UTC
  cancelled           Boolean?           @default(false)
  // Para saber quando foi cancelado
  cancelledAt         DateTime?          @db.Timestamptz
  //stripeChargeId String?
  BarbershopService   BarbershopService? @relation(fields: [barbershopServiceId], references: [id])
  barbershopServiceId String?
}

